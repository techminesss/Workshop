rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /registrations/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['fullName', 'phone', 'college', 'degree', 'agreed', 'seatNumber', 'registeredAt'])
                    && request.resource.data.fullName is string && request.resource.data.fullName.size() < 100
                    && request.resource.data.phone is string && request.resource.data.phone.size() == 10
                    && request.resource.data.college is string && request.resource.data.college.size() < 150
                    && request.resource.data.degree is string && request.resource.data.degree.size() < 100;
      allow read, update, delete: if false;
    }
    match /meta/seats {
      allow read: if true;
      allow update: if request.resource.data.seatsLeft == resource.data.seatsLeft - 1;
      allow create, delete: if false;
    }
  }
}
